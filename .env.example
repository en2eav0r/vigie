# Copy to .env on the server. Never commit .env.
VIGIE_PROVIDER=openai               # anthropic | openai | gemini | deepseek | mistral | groq | openrouter | xai | ollama
VIGIE_MODEL=gpt-4.1-mini            # see python -m server.models list
VIGIE_EFFORT=medium
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
OLLAMA_BASE_URL=                    # e.g. http://localhost:11434/v1
VIGIE_BACKUP_PROVIDER=              # optional, used only when the first provider does not answer
VIGIE_BACKUP_MODEL=

# Threat intelligence (each one optional)
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=
URLHAUS_AUTH_KEY=
URLSCAN_API_KEY=
ABUSEIPDB_API_KEY=
BRAVE_SEARCH_API_KEY=

# Limits
VIGIE_DAILY_QUOTA=20                # investigations per client token per day
VIGIE_DAILY_SPEND_CAP_USD=5
VIGIE_INVESTIGATION_TIMEOUT=45
VIGIE_MAX_COST_USD=0.01             # hard ceiling per investigation
VIGIE_MAX_AGENT_TURNS=4
